    "comlink": "^4.4.2",
    "d3": "^7.9.0",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "jotai": "^3.0.1",
    "lodash": "^4.18.1",
    "p5": "^2.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-p5": "^1.4.1",
    "react-player": "^3.4.0",
    "react-router": "^8.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
