    "@types/d3": "^7.4.3",
    "@types/lodash": "^4.17.27",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/p5": "^1.7.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
